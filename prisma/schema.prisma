generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

enum MeasurementSystem {
  METRIC
  IMPERIAL
}

enum SiteMode {
  SIMULATED
  HARDWARE
}

enum SiteStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum EquipmentStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  ARCHIVED
}

enum TelemetrySource {
  SIMULATOR
  HARDWARE
}

enum TelemetryQuality {
  SIMULATED
  MEASURED
  ESTIMATED
  STALE
  MISSING
}

enum GatewayMode {
  VIRTUAL
  HARDWARE
}

enum GatewayStatus {
  PENDING
  ONLINE
  DEGRADED
  STALE
  OFFLINE
  REVOKED
}

enum GatewayDeviceKind {
  PV_ARRAY
  INVERTER
  BATTERY
  GRID_METER
  LOAD_METER
  WEATHER_SENSOR
}

enum DeviceConnectivityStatus {
  NEVER_SEEN
  ONLINE
  STALE
  OFFLINE
}

enum DeviceOperationalState {
  UNKNOWN
  RUNNING
  STANDBY
  STOPPED
  FAULT
}

enum TelemetryBatchStatus {
  ACCEPTED
  REJECTED
}

enum WeatherProvider {
  OPEN_METEO
}

enum SolarForecastSource {
  MODEL
}

enum ForecastActualQuality {
  SIMULATED
  MEASURED
  ESTIMATED
  MIXED
}

enum AlertType {
  GRID_OUTAGE
  GATEWAY_OFFLINE
  DEVICE_OFFLINE
  INVERTER_FAULT
  BATTERY_LOW
  PV_UNDERPERFORMANCE
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

enum AlertEvidenceQuality {
  SIMULATED
  MEASURED
  MIXED
}

enum ReportType {
  WEEKLY
  MONTHLY
}

enum SupportTicketCategory {
  TECHNICAL
  ACCOUNT
  DATA_FORECAST
  FEATURE_REQUEST
}

enum SupportTicketPriority {
  NORMAL
  HIGH
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AdminAuditAction {
  USER_STATUS_CHANGED
  SUPPORT_TICKET_UPDATED
}

model User {
  id                 String           @id @default(cuid())
  name               String
  username           String?          @unique
  email              String           @unique
  emailVerified      Boolean          @default(false)
  image              String?
  role               UserRole         @default(USER)
  status             UserStatus       @default(ACTIVE)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?
  accounts           Account[]
  sessions           Session[]
  preference         UserPreference?
  ownedSites         SolarSite[]
  generatedReports   ReportSnapshot[]
  supportTickets     SupportTicket[]
  adminActions       AdminAuditLog[]  @relation("AdminAuditActor")
  adminTargetActions AdminAuditLog[]  @relation("AdminAuditTargetUser")

  @@index([status, createdAt])
  @@index([deletedAt, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model UserPreference {
  id                 String            @id @default(cuid())
  userId             String            @unique
  theme              ThemePreference   @default(SYSTEM)
  timezone           String            @default("Asia/Colombo")
  measurementSystem  MeasurementSystem @default(METRIC)
  emailNotifications Boolean           @default(true)
  defaultSiteId      String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([defaultSiteId])
}

model SolarSite {
  id                  String               @id @default(cuid())
  ownerId             String
  name                String
  slug                String               @unique
  latitude            Float
  longitude           Float
  timezone            String               @default("Asia/Colombo")
  mode                SiteMode             @default(SIMULATED)
  status              SiteStatus           @default(ACTIVE)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  owner               User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  arrays              SolarArray[]
  inverters           Inverter[]
  battery             Battery?
  telemetry           TelemetryReading[]
  gateways            EdgeGateway[]
  weatherObservations WeatherObservation[]
  weatherForecastRuns WeatherForecastRun[]
  solarForecastRuns   SolarForecastRun[]
  alertIncidents      AlertIncident[]
  reportSnapshots     ReportSnapshot[]
  supportTickets      SupportTicket[]

  @@index([ownerId, status])
  @@index([ownerId, createdAt])
}

model AlertIncident {
  id               String               @id @default(cuid())
  siteId           String
  openKey          String?              @unique
  type             AlertType
  severity         AlertSeverity
  status           AlertStatus          @default(ACTIVE)
  title            String
  summary          String
  evidenceQuality  AlertEvidenceQuality
  evidence         Json
  firstDetectedAt  DateTime
  lastDetectedAt   DateTime
  occurrenceCount  Int                  @default(1)
  acknowledgedAt   DateTime?
  acknowledgedById String?
  resolvedAt       DateTime?
  resolvedById     String?
  resolutionReason String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  site             SolarSite            @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, status, lastDetectedAt(sort: Desc)])
  @@index([siteId, type, firstDetectedAt(sort: Desc)])
  @@index([siteId, severity, status])
}

model ReportSnapshot {
  id            String     @id @default(cuid())
  siteId        String
  generatedById String?
  type          ReportType
  periodStartAt DateTime
  periodEndAt   DateTime
  generatedAt   DateTime   @default(now())
  schemaVersion String
  dataHash      String
  payload       Json
  site          SolarSite  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  generatedBy   User?      @relation(fields: [generatedById], references: [id], onDelete: SetNull)

  @@unique([siteId, type, periodStartAt, periodEndAt, dataHash])
  @@index([siteId, generatedAt(sort: Desc)])
  @@index([siteId, type, periodStartAt(sort: Desc)])
  @@index([generatedById])
}

model SupportTicket {
  id            String                @id @default(cuid())
  userId        String
  siteId        String?
  category      SupportTicketCategory
  priority      SupportTicketPriority @default(NORMAL)
  status        SupportTicketStatus   @default(OPEN)
  subject       String
  message       String
  adminResponse String?
  respondedAt   DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  site          SolarSite?            @relation(fields: [siteId], references: [id], onDelete: SetNull)
  auditLogs     AdminAuditLog[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([status, priority, createdAt])
  @@index([siteId, status])
}

model AdminAuditLog {
  id              String           @id @default(cuid())
  actorId         String?
  targetUserId    String?
  supportTicketId String?
  action          AdminAuditAction
  summary         String
  metadata        Json
  createdAt       DateTime         @default(now())
  actor           User?            @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser      User?            @relation("AdminAuditTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  supportTicket   SupportTicket?   @relation(fields: [supportTicketId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([targetUserId, createdAt(sort: Desc)])
  @@index([supportTicketId, createdAt(sort: Desc)])
}

model WeatherObservation {
  id                        String          @id @default(cuid())
  siteId                    String
  provider                  WeatherProvider
  observedAt                DateTime
  fetchedAt                 DateTime        @default(now())
  condition                 String
  temperatureAirC           Float
  apparentTemperatureC      Float?
  relativeHumidityPct       Int?
  cloudCoverPct             Int?
  precipitationMm           Float?
  weatherCode               Int
  windSpeedKmh              Float?
  windDirectionDeg          Int?
  shortwaveRadiationWm2     Float?
  directRadiationWm2        Float?
  diffuseRadiationWm2       Float?
  directNormalIrradianceWm2 Float?
  globalTiltedIrradianceWm2 Float?
  isDay                     Boolean?
  raw                       Json?
  site                      SolarSite       @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, provider, observedAt])
  @@index([siteId, observedAt(sort: Desc)])
  @@index([siteId, provider, fetchedAt(sort: Desc)])
}

model WeatherForecastRun {
  id                       String                 @id @default(cuid())
  siteId                   String
  provider                 WeatherProvider
  modelSelection           String                 @default("best_match")
  fetchedAt                DateTime               @default(now())
  forecastDays             Int
  requestLatitude          Float
  requestLongitude         Float
  requestTimezone          String
  requestTiltDeg           Float?
  requestAzimuthDeg        Float?
  responseTimezone         String?
  responseUtcOffsetSeconds Int?
  generationTimeMs         Float?
  attribution              String                 @default("Weather data by Open-Meteo.com")
  rawMetadata              Json?
  site                     SolarSite              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  points                   WeatherForecastPoint[]
  solarForecastRuns        SolarForecastRun[]

  @@unique([siteId, provider, fetchedAt])
  @@index([siteId, fetchedAt(sort: Desc)])
  @@index([siteId, provider, fetchedAt(sort: Desc)])
}

model WeatherForecastPoint {
  id                          String             @id @default(cuid())
  weatherForecastRunId        String
  validAt                     DateTime
  condition                   String
  temperatureAirC             Float?
  relativeHumidityPct         Int?
  cloudCoverPct               Int?
  precipitationProbabilityPct Int?
  precipitationMm             Float?
  windSpeedKmh                Float?
  weatherCode                 Int?
  shortwaveRadiationWm2       Float?
  directRadiationWm2          Float?
  diffuseRadiationWm2         Float?
  directNormalIrradianceWm2   Float?
  globalTiltedIrradianceWm2   Float?
  forecastRun                 WeatherForecastRun @relation(fields: [weatherForecastRunId], references: [id], onDelete: Cascade)

  @@unique([weatherForecastRunId, validAt])
  @@index([validAt])
}

model SolarForecastRun {
  id                          String               @id @default(cuid())
  siteId                      String
  weatherForecastRunId        String
  requestId                   String               @unique
  issuedAt                    DateTime
  installedCapacityKwp        Float
  modelName                   String
  modelFamily                 String
  modelStatus                 String
  artifactSha256              String
  featureSchemaVersion        String
  productionActivationAllowed Boolean              @default(false)
  estimatedEnergyKwh          Float
  estimatedLoadEnergyKwh      Float?
  loadForecastMethod          String?
  daylightHours               Int
  limitations                 Json
  createdAt                   DateTime             @default(now())
  site                        SolarSite            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  weatherForecastRun          WeatherForecastRun   @relation(fields: [weatherForecastRunId], references: [id], onDelete: Restrict)
  points                      SolarForecastPoint[]

  @@index([siteId, createdAt(sort: Desc)])
  @@index([weatherForecastRunId])
}

model SolarForecastPoint {
  id                     String                     @id @default(cuid())
  solarForecastRunId     String
  validAt                DateTime
  leadHours              Float
  capacityFactor         Float
  estimatedPowerKw       Float
  estimatedEnergyKwh     Float
  estimatedLoadPowerKw   Float?
  estimatedLoadEnergyKwh Float?
  source                 SolarForecastSource        @default(MODEL)
  forecastRun            SolarForecastRun           @relation(fields: [solarForecastRunId], references: [id], onDelete: Cascade)
  verification           SolarForecastVerification?

  @@unique([solarForecastRunId, validAt])
  @@index([validAt])
}

model SolarForecastVerification {
  id                   String                @id @default(cuid())
  solarForecastPointId String                @unique
  intervalStartAt      DateTime
  intervalEndAt        DateTime
  actualEnergyKwh      Float
  errorKwh             Float
  absoluteErrorKwh     Float
  squaredErrorKwh2     Float
  coveragePct          Float
  sampleCount          Int
  sampleIntervalSec    Int
  actualQuality        ForecastActualQuality
  verifiedAt           DateTime              @default(now())
  point                SolarForecastPoint    @relation(fields: [solarForecastPointId], references: [id], onDelete: Cascade)

  @@index([verifiedAt(sort: Desc)])
  @@index([actualQuality, verifiedAt(sort: Desc)])
}

model TelemetryReading {
  id                   String           @id @default(cuid())
  siteId               String
  gatewayId            String?
  telemetryBatchId     String?          @unique
  observedAt           DateTime
  source               TelemetrySource
  quality              TelemetryQuality
  pvPowerW             Int
  pvEnergyTodayWh      Int
  loadPowerW           Int
  gridPowerW           Int
  batteryPowerW        Int
  batterySocPct        Int
  dcVoltageV           Float
  dcCurrentA           Float
  acVoltageV           Float
  acCurrentA           Float
  gridVoltageV         Float
  frequencyHz          Float
  inverterTemperatureC Float
  panelTemperatureC    Float
  irradianceWm2        Int
  deviceStatus         String
  createdAt            DateTime         @default(now())
  site                 SolarSite        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  gateway              EdgeGateway?     @relation(fields: [gatewayId], references: [id], onDelete: SetNull)
  telemetryBatch       TelemetryBatch?  @relation(fields: [telemetryBatchId], references: [id], onDelete: SetNull)

  @@unique([siteId, source, observedAt])
  @@index([siteId, observedAt(sort: Desc)])
  @@index([gatewayId, observedAt(sort: Desc)])
}

model EdgeGateway {
  id                         String             @id @default(cuid())
  siteId                     String
  name                       String
  gatewayUid                 String             @unique @default(uuid())
  mode                       GatewayMode
  status                     GatewayStatus      @default(PENDING)
  credentialHash             String?            @unique
  pendingCredentialHash      String?            @unique
  pendingCredentialExpiresAt DateTime?
  credentialVersion          Int                @default(1)
  credentialRotatedAt        DateTime?
  enrollmentTokenHash        String?            @unique
  enrollmentExpiresAt        DateTime?
  expectedIntervalSec        Int                @default(30)
  lastSequence               Int?
  softwareVersion            String?
  lastSeenAt                 DateTime?
  lastHeartbeatAt            DateTime?
  lastTelemetryAt            DateTime?
  enrolledAt                 DateTime?
  revokedAt                  DateTime?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  site                       SolarSite          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  devices                    GatewayDevice[]
  heartbeats                 GatewayHeartbeat[]
  telemetryBatches           TelemetryBatch[]
  telemetryReadings          TelemetryReading[]

  @@index([siteId, status])
  @@index([siteId, createdAt])
}

model GatewayHeartbeat {
  id                String      @id @default(cuid())
  gatewayId         String
  heartbeatId       String
  sentAt            DateTime
  receivedAt        DateTime    @default(now())
  softwareVersion   String
  publishingEnabled Boolean
  queueDepth        Int
  deviceCount       Int
  gateway           EdgeGateway @relation(fields: [gatewayId], references: [id], onDelete: Cascade)

  @@unique([gatewayId, heartbeatId])
  @@index([gatewayId, receivedAt(sort: Desc)])
}

model GatewayDevice {
  id                  String                   @id @default(cuid())
  gatewayId           String
  externalId          String
  kind                GatewayDeviceKind
  name                String
  manufacturer        String?
  model               String?
  serialNumber        String?
  connectivityStatus  DeviceConnectivityStatus @default(NEVER_SEEN)
  operationalState    DeviceOperationalState   @default(UNKNOWN)
  expectedIntervalSec Int                      @default(30)
  lastSeenAt          DateTime?
  metrics             Json?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  gateway             EdgeGateway              @relation(fields: [gatewayId], references: [id], onDelete: Cascade)
  observations        DeviceObservation[]

  @@unique([gatewayId, externalId])
  @@index([gatewayId, connectivityStatus])
  @@index([serialNumber])
}

model TelemetryBatch {
  id           String               @id @default(cuid())
  gatewayId    String
  batchId      String
  sequence     Int
  sentAt       DateTime
  receivedAt   DateTime             @default(now())
  source       GatewayMode
  status       TelemetryBatchStatus @default(ACCEPTED)
  gateway      EdgeGateway          @relation(fields: [gatewayId], references: [id], onDelete: Cascade)
  observations DeviceObservation[]
  reading      TelemetryReading?

  @@unique([gatewayId, batchId])
  @@unique([gatewayId, sequence])
  @@index([gatewayId, receivedAt(sort: Desc)])
}

model DeviceObservation {
  id                 String                   @id @default(cuid())
  telemetryBatchId   String
  deviceId           String
  reportedAt         DateTime
  lastTelemetryAt    DateTime?
  quality            TelemetryQuality
  connectivityStatus DeviceConnectivityStatus
  operationalState   DeviceOperationalState
  metrics            Json
  createdAt          DateTime                 @default(now())
  telemetryBatch     TelemetryBatch           @relation(fields: [telemetryBatchId], references: [id], onDelete: Cascade)
  device             GatewayDevice            @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([telemetryBatchId, deviceId])
  @@index([deviceId, reportedAt(sort: Desc)])
}

model SolarArray {
  id                         String          @id @default(cuid())
  siteId                     String
  name                       String
  manufacturer               String?
  model                      String?
  panelCount                 Int
  ratedPowerW                Int
  tiltDeg                    Float
  azimuthDeg                 Float
  installationDate           DateTime?
  temperatureCoefficientPctC Float?
  status                     EquipmentStatus @default(ACTIVE)
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt
  archivedAt                 DateTime?
  site                       SolarSite       @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, name])
  @@index([siteId, status])
}

model Inverter {
  id                   String          @id @default(cuid())
  siteId               String
  manufacturer         String
  model                String
  serialAlias          String?
  acRatingW            Int
  efficiencyPct        Float
  phase                Int             @default(1)
  communicationAdapter String          @default("SIMULATOR")
  pollingIntervalSec   Int             @default(15)
  status               EquipmentStatus @default(ACTIVE)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  archivedAt           DateTime?
  site                 SolarSite       @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, status])
}

model Battery {
  id                     String          @id @default(cuid())
  siteId                 String          @unique
  enabled                Boolean         @default(true)
  manufacturer           String?
  model                  String?
  usableCapacityWh       Int
  maxChargePowerW        Int
  maxDischargePowerW     Int
  minSocPct              Int             @default(10)
  maxSocPct              Int             @default(95)
  roundTripEfficiencyPct Float
  reservePct             Int             @default(20)
  status                 EquipmentStatus @default(ACTIVE)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  site                   SolarSite       @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, status])
}
