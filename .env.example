# PostgreSQL runtime connection. Add connection_limit=1 for serverless deployments.
DATABASE_URL="postgresql://aelora:replace-with-local-password@127.0.0.1:5432/aelora?schema=public"

# Generate with: npx auth secret
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Bearer secret for POST /api/internal/weather-sync. Generate a long random value.
WEATHER_SYNC_SECRET="replace-with-at-least-32-random-characters"

# Private server-to-server ML inference service. Never prefix the token with NEXT_PUBLIC_.
AELORA_ML_BASE_URL="http://127.0.0.1:8000"
AELORA_ML_INTERNAL_API_TOKEN="use-the-exact-same-token-as-aelora-ml-service"

# Local Docker Compose only; do not reuse in deployed environments.
AELORA_POSTGRES_PASSWORD="replace-with-local-password"

# Optional local PostgreSQL tooling overrides for backup/restore verification.
# Windows example: C:/Program Files/PostgreSQL/18/bin
POSTGRES_BIN_DIR=""
AELORA_BACKUP_DIR="./backups"

# Development seed credentials. Choose strong local-only passwords.
SEED_ADMIN_EMAIL="admin@aelora.local"
SEED_ADMIN_PASSWORD="replace-with-strong-admin-password"
SEED_USER_EMAIL="user@aelora.local"
SEED_USER_PASSWORD="replace-with-strong-user-password"
